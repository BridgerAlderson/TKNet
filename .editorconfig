root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{cs,py,sh}]
indent_style = space
indent_size = 4

[*.{axaml,csproj,json,yml}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
