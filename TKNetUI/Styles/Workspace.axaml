<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="CanvasBrush">#10151E</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBrush">#151B25</SolidColorBrush>
    <SolidColorBrush x:Key="RaisedBrush">#1C2431</SolidColorBrush>
    <SolidColorBrush x:Key="LineBrush">#2C3747</SolidColorBrush>
    <SolidColorBrush x:Key="TextBrush">#E5EAF2</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#A0AEC0</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#79C6DB</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="1.4"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.fieldlabel">
    <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#C4CEDB"/>
    <Setter Property="Margin" Value="0,0,0,7"/>
  </Style>
  <Style Selector="TextBlock.sectiontitle">
    <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="#101620"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="10,8"/>
    <Setter Property="SelectionBrush" Value="#345B71"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="#101620"/></Style>
  <Style Selector="TextBox.scope">
    <Setter Property="FontFamily" Value="Cascadia Code, DejaVu Sans Mono, Consolas, monospace"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12"/><Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="13,8"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2B394B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#52677E"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#101620"/></Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#83CEE0"/><Setter Property="BorderBrush" Value="#83CEE0"/><Setter Property="Foreground" Value="#10202C"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A5E3EF"/><Setter Property="Foreground" Value="#10202C"/><Setter Property="BorderBrush" Value="#A5E3EF"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#63B4C9"/><Setter Property="Foreground" Value="#10202C"/></Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="#F2ADAD"/><Setter Property="BorderBrush" Value="#70464F"/><Setter Property="Background" Value="#30202A"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#54313D"/><Setter Property="Foreground" Value="#FFD5D5"/></Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
  </Style>
  <Style Selector="Button.active">
    <Setter Property="Background" Value="#203241"/><Setter Property="BorderBrush" Value="#3E6175"/><Setter Property="Foreground" Value="#AADEEB"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1B222E"/><Setter Property="Foreground" Value="#758295"/><Setter Property="BorderBrush" Value="#2C3747"/>
  </Style>
  <Style Selector="Button.backdrop"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/></Style>
  <Style Selector="Button.backdrop:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Button.backdrop:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="CheckBox"><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="#101620"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="CornerRadius" Value="5"/></Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#232D3C"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="MinColumnWidth" Value="60"/>
  </Style>
  <Style Selector="DataGridRow"><Setter Property="MinHeight" Value="44"/></Style>
  <Style Selector="DataGridCell"><Setter Property="Padding" Value="12,8"/></Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="#1B2431"/><Setter Property="Foreground" Value="#B6C4D5"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="12,12"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="Border.sharechip">
    <Setter Property="Background" Value="#232A35"/><Setter Property="BorderBrush" Value="#4B5666"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="9,5"/>
  </Style>
  <Style Selector="Border.sharechip TextBlock"><Setter Property="Foreground" Value="#BEC7D4"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Border.sharechip.ro"><Setter Property="Background" Value="#1A3347"/><Setter Property="BorderBrush" Value="#3D6B89"/></Style>
  <Style Selector="Border.sharechip.ro TextBlock"><Setter Property="Foreground" Value="#ABD9F5"/></Style>
  <Style Selector="Border.sharechip.rw"><Setter Property="Background" Value="#1A342E"/><Setter Property="BorderBrush" Value="#3F7564"/></Style>
  <Style Selector="Border.sharechip.rw TextBlock"><Setter Property="Foreground" Value="#A4DDC4"/></Style>
  <Style Selector="Border.sharechip:focus-visible"><Setter Property="BorderBrush" Value="#D5E7F0"/></Style>
  <Style Selector="Border.sharechip:pointerover"><Setter Property="BorderBrush" Value="#D5E7F0"/></Style>
  <Style Selector="TabControl"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="16,14"/></Style>
  <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="#B3E4EF"/></Style>
  <Style Selector="Border.running"><Setter Property="Background" Value="#1D3842"/><Setter Property="BorderBrush" Value="#4E8796"/></Style>
  <Style Selector="Border.running TextBlock"><Setter Property="Foreground" Value="#AAE3EF"/></Style>
  <Style Selector="Separator"><Setter Property="Background" Value="{StaticResource LineBrush}"/></Style>
  <Style Selector="ContextMenu"><Setter Property="Background" Value="#202A38"/><Setter Property="BorderBrush" Value="#435269"/></Style>
  <Style Selector="MenuItem"><Setter Property="Padding" Value="10,8"/></Style>
  <Style Selector="ToolTip"><Setter Property="Background" Value="#263449"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
  <!-- Compact spacing preserves a usable result viewport on smaller displays. -->
  <Style Selector="Grid.workspace"><Setter Property="Margin" Value="16"/></Style>
  <Style Selector="Grid.resultsheader"><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style Selector="Grid.filterbar"><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style Selector="TextBlock.stats"><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style Selector="Border.resulthelp"><Setter Property="Padding" Value="14,10"/></Style>
  <Style Selector="Border.activitypanel"><Setter Property="Margin" Value="0,12,0,0"/></Style>
  <Style Selector="TextBox.activity"><Setter Property="Height" Value="130"/></Style>
  <Style Selector="Border.scanstate"><Setter Property="Background" Value="#1A2928"/><Setter Property="BorderBrush" Value="#3B5A52"/></Style>
  <Style Selector="Border.scanstate TextBlock"><Setter Property="Foreground" Value="#B0D6C5"/></Style>
  <Style Selector="Border.scanstate.running"><Setter Property="Background" Value="#1D3842"/><Setter Property="BorderBrush" Value="#4E8796"/></Style>
  <Style Selector="Border.scanstate.running TextBlock"><Setter Property="Foreground" Value="#AAE3EF"/></Style>
  <Style Selector="Window.compact Grid.workspace"><Setter Property="Margin" Value="12"/></Style>
  <Style Selector="Window.compact Grid.resultsheader"><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style Selector="Window.compact TextBlock.resultsubtitle"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Window.compact Grid.filterbar"><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style Selector="Window.compact TextBlock.stats"><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style Selector="Window.compact TabItem"><Setter Property="Padding" Value="14,9"/></Style>
  <Style Selector="Window.compact Border.resulthelp"><Setter Property="Padding" Value="12,7"/></Style>
  <Style Selector="Window.compact Border.activitypanel"><Setter Property="Margin" Value="0,8,0,0"/></Style>
  <Style Selector="Window.compact TextBox.activity"><Setter Property="Height" Value="60"/></Style>
</Styles>
